{
  "name": "@or-on/crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./field-service-domain": {
      "types": "./src/field-service-domain.ts",
      "default": "./dist/field-service-domain.js"
    },
    "./service-workflow": {
      "types": "./src/service-workflow.ts",
      "default": "./dist/service-workflow.js"
    },
    "./support-profile-text": {
      "types": "./src/support-profile-text.ts",
      "default": "./dist/support-profile-text.js"
    },
    "./tenant-configuration-client": {
      "types": "./src/tenant-configuration-client.ts",
      "default": "./dist/tenant-configuration-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
