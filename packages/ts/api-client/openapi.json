      "Direction": {
        "description": "Which side placed the call.\n\nBROWSER is not a third side — it is the console's mic with no PSTN leg at\nall. It exists because a test call recorded as `inbound` is indistinguishable\nfrom a voter's, which silently mixes rehearsals into the campaign's numbers.",
        "enum": ["inbound", "outbound", "browser"],
        "title": "Direction",
        "type": "string"
      },
