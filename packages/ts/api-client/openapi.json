{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "postgres": {
            "enum": ["ready", "unavailable"],
            "title": "Postgres",
            "type": "string"
          }
        },
        "required": ["postgres"],
        "title": "DependencyStatus",
        "type": "object"
      },
      "Direction": {
        "description": "Which side placed the call.\n\nBROWSER is not a third side — it is the console's mic with no PSTN leg at\nall. It exists because a test call recorded as `inbound` is indistinguishable\nfrom a voter's, which silently mixes rehearsals into the campaign's numbers.",
        "enum": ["inbound", "outbound", "browser"],
        "title": "Direction",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveStatus": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["service"],
        "title": "LiveStatus",
        "type": "object"
      },
      "ReadyStatus": {
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/DependencyStatus"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": ["ready", "not_ready"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status", "service", "dependencies"],
        "title": "ReadyStatus",
        "type": "object"
      },
      "SessionStatus": {
        "enum": ["started", "ended", "failed"],
        "title": "SessionStatus",
        "type": "string"
      },
      "SimulatedCallRequest": {
        "properties": {
          "contact_id": {
            "format": "uuid",
            "title": "Contact Id",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "mode": {
            "const": "simulator",
            "default": "simulator",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": ["contact_id", "idempotency_key"],
        "title": "SimulatedCallRequest",
        "type": "object"
      },
      "SimulatedCallResult": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "event_types": {
            "items": {
              "type": "string"
            },
            "title": "Event Types",
            "type": "array"
          },
          "session": {
            "$ref": "#/components/schemas/VoiceSessionSummary"
          }
        },
        "required": ["session", "created", "event_types"],
        "title": "SimulatedCallResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceSessionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/VoiceSessionSummary"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items"],
        "title": "VoiceSessionList",
        "type": "object"
      },
      "VoiceSessionSummary": {
        "properties": {
          "answered": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answered"
          },
          "contact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "platform_campaign_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform Campaign Id"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          }
        },
        "required": [
          "session_id",
          "contact_id",
          "platform_campaign_id",
          "provider",
          "direction",
          "status",
          "answered",
          "outcome",
          "created_at",
          "ended_at"
        ],
        "title": "VoiceSessionSummary",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Or-On Platform Control API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/voice/sessions": {
      "get": {
        "operationId": "list_voice_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceSessionList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Voice Sessions",
        "tags": ["voice"]
      }
    },
    "/api/v1/voice/simulated-calls": {
      "post": {
        "operationId": "simulate_voice_call",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulatedCallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatedCallResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Simulate Voice Call",
        "tags": ["voice"]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "get_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": ["system"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": ["system"]
      }
    }
  }
}
