{
  "components": {
    "schemas": {
      "CallUsage": {
        "description": "Per-call consumption.\n\n`call_seconds` is measured caller-join → caller-leave, not from the session\nrow's lifetime: `ended_at` is stamped after recording stops, a settle delay\nand an artifact upload, all of which would otherwise bill as talk time.\n\nThe model names are recorded because they are configurable at runtime, so\nthe rate that applies is a property of the call, not of today's config.",
        "properties": {
          "call_seconds": {
            "default": 0.0,
            "title": "Call Seconds",
            "type": "number"
          },
          "carrier": {
            "default": "",
            "title": "Carrier",
            "type": "string"
          },
          "llm_cached_prompt_tokens": {
            "default": 0,
            "title": "Llm Cached Prompt Tokens",
            "type": "integer"
          },
          "llm_completion_tokens": {
            "default": 0,
            "title": "Llm Completion Tokens",
            "type": "integer"
          },
          "llm_model": {
            "default": "",
            "title": "Llm Model",
            "type": "string"
          },
          "llm_prompt_tokens": {
            "default": 0,
            "title": "Llm Prompt Tokens",
            "type": "integer"
          },
          "stt_audio_seconds": {
            "default": 0.0,
            "title": "Stt Audio Seconds",
            "type": "number"
          },
          "tts_audio_seconds": {
            "default": 0.0,
            "title": "Tts Audio Seconds",
            "type": "number"
          },
          "tts_characters": {
            "default": 0,
            "title": "Tts Characters",
            "type": "integer"
          },
          "tts_model": {
            "default": "",
            "title": "Tts Model",
            "type": "string"
          }
        },
        "title": "CallUsage",
        "type": "object"
      },
      "CanonicalFlowContract": {
        "properties": {
          "channels": {
            "items": {
              "enum": ["voice", "whatsapp"],
              "type": "string"
            },
            "title": "Channels",
            "type": "array"
