{
	admin off
	auto_https off
}

:80 {
	request_body {
		max_size 22MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	handle /livekit/webhook {
		reverse_proxy dispatcher:8082
	}
	handle {
		reverse_proxy web:3000
	}
}

http://127.0.0.1:8080 {
	respond /healthz "ok" 200
}
