{
  "$comment": "Reviewable ProTouch configuration, published through tenant configuration approval. Phone collects only name and fault, then sends the private digital form after consent. A direct WhatsApp service request uses service_form to send the same form in its verified conversation. Only explicit customer submission creates a case. General templates remain disabled; only the separately reviewed service-link template is allowed for a consenting phone caller outside the WhatsApp service window.",
  "tenantSlugHint": "protouch",
  "features": [
    "contacts",
    "agents",
    "whatsapp",
    "voice",
    "tickets",
    "field_service",
    "technicians",
    "documents",
    "reports",
    "appointments"
  ],
  "featureConfiguration": {
    "field_service": {
      "workflow": {
        "version": 1,
        "requiredIntakeFields": [
          "customerName",
          "customerPhone",
          "serviceLocation",
          "faultDescription"
        ],
        "photoPolicy": "requested",
        "selfAssignmentEnabled": true,
        "requiredReportFields": ["diagnosis", "workPerformed"],
        "inquiry": {
          "openOnFirstContact": false
        },
        "whatsappFollowUp": {
          "enabled": true,
          "trigger": "intake_saved",
          "requestPhoto": true,
          "consent": "in_call_agreement",
          "mode": "form"
        },
        "emergency": {
          "enabled": true,
          "label": "קריאה אדומה",
          "manualRedCall": true,
          "fallback": "notify_staff"
        },
        "preparation": {
          "enabled": true,
          "requireAcknowledgement": true,
          "instructions": "יש לעבור על פרטי הקריאה ולוודא שכל הציוד הנדרש ברכב לפני היציאה.",
          "checklist": [
            {
              "key": "case_reviewed",
              "label": "קראתי את פרטי הקריאה והתקלה",
              "required": true
            },
            {
              "key": "parts_loaded",
              "label": "חלקי החילוף הרלוונטיים ברכב",
              "required": true
            },
            {
              "key": "tools_loaded",
              "label": "כלי העבודה והציוד הנדרש ברכב",
              "required": true
            },
            {
              "key": "rcg_forms",
              "label": "טופסי RCG זמינים",
              "required": false
            }
          ]
        },
        "attachmentCategories": [
          {
            "key": "rcg",
            "label": "RCG",
            "accept": ["pdf", "image"]
          }
        ],
        "evidence": {
          "beforePhotoRequired": true,
          "afterPhotoRequired": true
        }
      },
      "experience": "service_manager"
    }
  }
}
