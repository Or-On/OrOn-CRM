{
  "$comment": "Reviewable ProTouch configuration. Publish through the normal tenant configuration approval path. Phone collects only name and fault; WhatsApp sends a private digital form link inside an open customer-service window. Customer enters name, location, free-text fault and photos, then explicitly submits to create a case. ProTouch does not use templates. If WhatsApp is unavailable, retain the draft without claiming delivery or opening a case.",
  "tenantSlugHint": "protouch",
  "features": [
    "contacts",
    "agents",
    "whatsapp",
    "voice",
    "tickets",
    "field_service",
    "technicians",
    "documents",
    "reports",
    "appointments"
  ],
  "featureConfiguration": {
    "field_service": {
      "workflow": {
        "version": 1,
        "requiredIntakeFields": [
          "customerName",
          "customerPhone",
          "serviceLocation",
          "faultDescription"
        ],
        "photoPolicy": "requested",
        "selfAssignmentEnabled": true,
        "requiredReportFields": [
          "diagnosis",
          "workPerformed"
        ],
        "inquiry": {
          "openOnFirstContact": false
        },
        "whatsappFollowUp": {
          "enabled": true,
          "trigger": "intake_saved",
          "requestPhoto": true,
          "consent": "in_call_agreement",
          "mode": "form"
        },
        "emergency": {
          "enabled": true,
          "label": "קריאה אדומה",
          "manualRedCall": true,
          "fallback": "notify_staff"
        },
        "preparation": {
          "enabled": true,
          "requireAcknowledgement": true,
          "instructions": "יש לעבור על פרטי הקריאה ולוודא שכל הציוד הנדרש ברכב לפני היציאה.",
          "checklist": [
            {
              "key": "case_reviewed",
              "label": "קראתי את פרטי הקריאה והתקלה",
              "required": true
            },
            {
              "key": "parts_loaded",
              "label": "חלקי החילוף הרלוונטיים ברכב",
              "required": true
            },
            {
              "key": "tools_loaded",
              "label": "כלי העבודה והציוד הנדרש ברכב",
              "required": true
            },
            {
              "key": "rcg_forms",
              "label": "טופסי RCG זמינים",
              "required": false
            }
          ]
        },
        "attachmentCategories": [
          {
            "key": "rcg",
            "label": "RCG",
            "accept": [
              "pdf",
              "image"
            ]
          }
        ],
        "evidence": {
          "beforePhotoRequired": true,
          "afterPhotoRequired": true
        }
      },
      "experience": "service_manager"
    }
  }
}
