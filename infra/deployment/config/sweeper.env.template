# Session sweeper: the final repair for sessions left `started` by a dispatcher
# that could not durably finalize. It connects as the voice runtime role and can
# only call platform.fail_stale_voice_sessions for that role's session data;
# the deployment refuses to start unless DATABASE_URL is exactly the
# dispatcher's VOICE_DATABASE_URL. Never the migration role, and never the
# historical Or-on logins.
DATABASE_URL=postgresql://platform_voice:REPLACE_VOICE_PASSWORD@postgres:5432/REPLACE_DATABASE_NAME
# 60..10080. Must exceed the longest plausible live call, or live calls fail underneath it.
STALE_SESSION_MINUTES=120
# Container-local pacing of one bounded sweep pass.
SWEEP_INTERVAL_SECONDS=3600
