# PLATFORM
PLATFORM_ENV=development
PLATFORM_SERVICE=local-development
CONTROL_API_URL=http://127.0.0.1:8000
CONTROL_API_BIND_HOST=127.0.0.1
WEB_PORT=3000
CONTROL_API_PORT=8000
LOG_LEVEL=INFO

# DATABASE
POSTGRES_DB=or_on_platform_dev
POSTGRES_USER=platform_migrator
POSTGRES_PASSWORD=platform-migrator-dev-only
POSTGRES_PORT=5433
MIGRATION_DATABASE_URL=postgresql://platform_migrator:platform-migrator-dev-only@127.0.0.1:5433/or_on_platform_dev
DATABASE_URL=postgresql://platform_web:platform-web-dev-only@127.0.0.1:5433/or_on_platform_dev
MESSAGING_DATABASE_URL=postgresql://platform_messaging:platform-messaging-dev-only@127.0.0.1:5433/or_on_platform_dev
VOICE_DATABASE_URL=postgresql://platform_voice:platform-voice-dev-only@127.0.0.1:5433/or_on_platform_dev

# AUTH
# Generate local values; never reuse these values across environments.
AUTH_TOKEN_PEPPER=
AUTH_SERVICE_SECRET=
# A valid Argon2id hash used only to equalize unknown-user login work.
AUTH_DUMMY_PASSWORD_HASH=
AUTH_COOKIE_SECURE=false
# Bootstrap fills these local-only fictional operator values in ignored .env.
DEV_AUTH_EMAIL=operator@or-on.local
DEV_AUTH_PASSWORD_HASH=

# LIVEKIT
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INBOUND_TRUNK_NAME=oron-inbound
INBOUND_TRUNK_ALLOWED_ADDRESSES=[]
SIP_ALLOW_ANY_ADDRESS=false

# TELEPHONY
ENABLE_REAL_TELEPHONY=false
SIP_OUTBOUND_TRUNK_ID=
DISPATCHER_URL=
OUTBOUND_API_TOKEN=
FIELD_CIPHER_BACKEND=local
FIELD_CIPHER_LOCAL_KEY=
BLIND_INDEX_KEY=
KMS_KEY_NAME=
KMS_WRAPPED_DEK=

# WHATSAPP
ENABLE_REAL_WHATSAPP=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Non-secret Meta resource identifiers for the configured development account.
WHATSAPP_PHONE_NUMBER_ID=1312069101984418
WHATSAPP_WABA_ID=1507601250680263
WHATSAPP_META_APP_ID=1438019764708355
WHATSAPP_BUSINESS_PORTFOLIO_ID=1759453294641663
WHATSAPP_BUSINESS_PHONE_DISPLAY=+972-3-825-6893
# Keep this aligned with the stable Graph API version selected for the platform.
WHATSAPP_GRAPH_API_VERSION=v26.0

# AI
ENABLE_REAL_VOICE_PROVIDERS=false
AI_API_KEY=
AI_MODEL=
GOOGLE_CLOUD_PROJECT=
SONIOX_API_KEY=
LLM_PROVIDER=vertex
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_WARMUP=true
TURN_START=min_words
TURN_END=vad
INTERRUPT_MIN_WORDS=1
RENUKID_MODEL_PATH=
RENUKID_MODEL_SHA256=
ECAPA_MODEL_PATH=
ECAPA_MODEL_SHA256=

# OPENLIVE
OPENLIVE_PROVIDER_COMMAND=
OPENLIVE_LOCAL_MODEL=

# OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# GCP
GCP_PROJECT_ID=
GCP_REGION=
GCP_SECRET_PREFIX=
