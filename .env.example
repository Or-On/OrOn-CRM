# Safe local-development defaults. Copy to .env; never commit .env.

# PLATFORM
PLATFORM_ENV=development
PLATFORM_SERVICE=local-development
CONTROL_API_URL=http://127.0.0.1:8000
CONTROL_API_BIND_HOST=127.0.0.1
DISPATCHER_URL=http://127.0.0.1:8082
DISPATCHER_BIND_HOST=127.0.0.1
DISPATCHER_PORT=8082
PUBLIC_SITE_URL=http://127.0.0.1:3000
WEB_PORT=3000
CONTROL_API_PORT=8000
LOG_LEVEL=INFO

# POSTGRESQL (local-only example credentials)
POSTGRES_DB=or_on_platform_dev
POSTGRES_USER=platform_migrator
POSTGRES_PASSWORD=platform-migrator-dev-only
POSTGRES_PORT=5433
MIGRATION_DATABASE_URL=postgresql://platform_migrator:platform-migrator-dev-only@127.0.0.1:5433/or_on_platform_dev
DATABASE_URL=postgresql://platform_web:platform-web-dev-only@127.0.0.1:5433/or_on_platform_dev
MESSAGING_DATABASE_URL=postgresql://platform_messaging:platform-messaging-dev-only@127.0.0.1:5433/or_on_platform_dev
VOICE_DATABASE_URL=postgresql://platform_voice:platform-voice-dev-only@127.0.0.1:5433/or_on_platform_dev

# AUTHENTICATION — bootstrap generates local values in ignored .env.
AUTH_TOKEN_PEPPER=
AUTH_SERVICE_SECRET=
AUTH_DUMMY_PASSWORD_HASH=
AUTH_COOKIE_SECURE=false
DEV_AUTH_EMAIL=operator@or-on.local
DEV_AUTH_PASSWORD_HASH=

# LIVEKIT / SIP
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INBOUND_TRUNK_NAME=oron-inbound
INBOUND_TRUNK_ALLOWED_ADDRESSES=[]
SIP_ALLOW_ANY_ADDRESS=false
SIP_OUTBOUND_TRUNK_ID=
OUTBOUND_API_TOKEN=
ROOM_PREFIX=call-
BOT_IDENTITY=oron-agent

# PROVIDER SAFETY — all external actions stay disabled by default.
ENABLE_REAL_TELEPHONY=false
ENABLE_REAL_VOICE_PROVIDERS=false
VOICE_TEXT_DIAGNOSTICS=false
ENABLE_REAL_WHATSAPP=false
ENABLE_WHATSAPP_AI=false
ENABLE_WHATSAPP_AUTO_CALLS=false
ENABLE_REAL_BILLING=false

# WHATSAPP (identifiers are intentionally blank)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_META_APP_ID=
WHATSAPP_BUSINESS_PORTFOLIO_ID=
WHATSAPP_BUSINESS_PHONE_DISPLAY=
WHATSAPP_GRAPH_API_VERSION=v26.0

# VOICE / AI PROVIDERS
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_TTS_VOICE_DEFAULT=Harper
# Soniox semantic endpointing. These decide how soon the agent believes the
# caller finished, so they trade "answered halfway through my sentence" against
# "waited too long". The vendor's conversational starting point is level 2,
# sensitivity 0.3, 1500 ms; this deployment is deliberately less eager on
# sensitivity and firmer on the ceiling. Sweep them per call from the console
# rather than by rebuilding — they are also AgentOverrides fields.
SONIOX_ENDPOINT_LATENCY_ADJUSTMENT_LEVEL=2
SONIOX_ENDPOINT_SENSITIVITY=0.15
SONIOX_MAX_ENDPOINT_DELAY_MS=1000
LLM_PROVIDER=vertex
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Read only under LLM_PROVIDER=vertex, which is the default above. The model and
# thinking budget are the two knobs that decide a voice turn's time to first
# token, so they belong here rather than only in the code defaults.
VERTEX_LOCATION=global
VERTEX_LLM_MODEL=gemini-2.5-flash
VERTEX_THINKING_BUDGET=0
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.4
LLM_REQUEST_TIMEOUT_SECS=5.0
LLM_WARMUP=false
# Optional only when the selected model provider requires a project identifier.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
TTS_PROVIDER=soniox
TTS_FIRST_CLAUSE=true
TTS_NIQQUD=false
TTS_SPEED=1.0
TTS_TEXT_AGGREGATION=sentence
# Soniox only, and sent to the provider only when true. It shortens the gaps
# between WORDS — not the sentence or punctuation pauses that make a clause
# boundary sound mechanical — so it changes delivery without making the first
# word arrive sooner. Off is the vendor default, and the field on a model
# without silence-reduction support is an error rather than a no-op.
TTS_REDUCE_SILENCE=false
TURN_START=responsive
TURN_END=soniox
INTERRUPT_MIN_WORDS=1
USER_SPEECH_TIMEOUT=0.5
VAD_STOP_SECS=0.2
VAD_CONFIDENCE=0.35
VAD_MIN_VOLUME=0.35
AUDIO_IN_FILTER=rnnoise
GENDER_DETECTION_ENABLED=false
# Conversation timing. USER_IDLE_SECS is the silence before the caller is
# prompted; OPENER_HOLD_MAX_SECS caps how long inbound audio is held so the
# greeting cannot be talked over; ANSWER_TIMEOUT_SECS is how long an outbound
# call waits for a real pick-up before greeting anyway; AGENT_IDLE_TIMEOUT_SECS
# is the orphan-bot safety net, not a conversational timeout.
USER_IDLE_SECS=10.0
OPENER_HOLD_MAX_SECS=20.0
ANSWER_TIMEOUT_SECS=45.0
AGENT_IDLE_TIMEOUT_SECS=60

# OPTIONAL LOCAL MODEL FILES
RENUKID_MODEL_PATH=
RENUKID_MODEL_SHA256=
ECAPA_MODEL_PATH=
ECAPA_MODEL_SHA256=

# ENCRYPTION / OBJECTS
FIELD_CIPHER_BACKEND=local
FIELD_CIPHER_LOCAL_KEY=
BLIND_INDEX_KEY=
CREDENTIAL_ENCRYPTION_KEY=
ARTIFACTS_BACKEND=local
ARTIFACTS_LOCAL_ROOT=.objects

# BILLING
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OPTIONAL INTEGRATIONS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_SIP_DOMAIN=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
OPENLIVE_PROVIDER_COMMAND=
OPENLIVE_LOCAL_MODEL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
