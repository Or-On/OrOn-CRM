{
  "$comment": "Behavioural corpus for lead capture, written once and replayed by every harness. packages/py/oron-agent/tests/test_lead_scenario_corpus.py replays it against an in-memory store that models the platform functions' semantics, including the fault injections no database can be asked to produce on demand; db/tests/postgres/test_lead_scenario_corpus.py replays every fault-free scenario against the real platform.lead_* functions under the platform_voice role. packages/py/oron-agent/tests/eval/test_lead_capture_eval.py sends the scenarios marked providerEval to a model, and is skipped unless a provider evaluation is separately authorized. A scenario states what the caller said, the tool calls a correct agent makes, and the durable outcome; it never states what the model should say.",
  "corpusVersion": 1,
  "schemas": {
    "software": [
      { "key": "name", "label": "Preferred name", "type": "text", "required": true, "maxLength": 80 },
      { "key": "company", "label": "Company", "type": "text", "required": true },
      {
        "key": "service",
        "label": "Service",
        "type": "choice",
        "required": true,
        "choices": ["CRM", "ERP", "Consulting"]
      },
      { "key": "users", "label": "Users", "type": "number", "required": false, "minimum": 1, "maximum": 100000 },
      { "key": "budget", "label": "Budget", "type": "currency", "required": false, "minimum": 0 },
      { "key": "start_date", "label": "Start", "type": "date", "required": false },
      { "key": "email", "label": "Email", "type": "email", "required": false },
      { "key": "newsletter", "label": "Newsletter", "type": "boolean", "required": false }
    ],
    "property": [
      { "key": "area", "label": "Area", "type": "text", "required": true },
      { "key": "rooms", "label": "Rooms", "type": "number", "required": true, "minimum": 1, "maximum": 12 },
      { "key": "max_price", "label": "Maximum price", "type": "currency", "required": false, "minimum": 0 },
      { "key": "move_in", "label": "Move in", "type": "date", "required": false },
      { "key": "parking", "label": "Parking needed", "type": "boolean", "required": false },
      {
        "key": "visit_slot",
        "label": "Preferred viewing time",
        "type": "choice",
        "required": false,
        "choices": ["morning", "afternoon", "evening"]
      }
    ]
  },
  "scenarios": [
    {
      "id": "he-two-fields-in-one-turn",
      "intent": "The caller introduces herself and her company in one sentence.",
      "locale": "he",
      "channel": "voice",
      "schema": "software",
      "providerEval": true,
      "turns": [
        {
          "caller": "שלום, מדברת דנה מחברת אופק.",
          "calls": [
            {
              "tool": "lead_save_fields",
              "arguments": {
                "observations": [
                  { "key": "name", "state": "known", "value": "דנה" },
                  { "key": "company", "state": "known", "value": "אופק" }
                ]
              },
              "expect": { "ok": true, "saved": true }
            }
          ]
        }
      ],
      "expect": {
        "fields": { "name": { "state": "known", "value": "דנה" }, "company": { "state": "known", "value": "אופק" } },
        "missingRequired": ["service"],
        "status": "collecting",
        "saveClaimAllowed": true
      }
    },
    {
